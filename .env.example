# Variable NAMES only – never put real values in this file (the repo is public).
# Local: copy to .env.local and fill in. Netlify: set them per deploy context.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only (account deletion, reminders, Stripe webhook/billing API)

# Web push / reminders
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
REMINDERS_CRON_SECRET=
APP_URL=                            # e.g. https://wendapply.ch (return URLs for e-mails and Stripe)

# Stripe billing (docs/billing/*). Default OFF: anything but "true" keeps the site free as today.
STRIPE_ENABLED=                     # server flag: "true" enables /api/billing/* and /api/stripe/webhook
NEXT_PUBLIC_STRIPE_ENABLED=         # client flag: "true" shows the payment UI
STRIPE_SECRET_KEY=                  # sk_test_… locally / deploy previews; sk_live_… only in Netlify production
STRIPE_WEBHOOK_SECRET=              # whsec_… (local: `stripe listen --print-secret`; prod: the webhook endpoint's secret)
STRIPE_PORTAL_CONFIGURATION_ID=     # bpc_… (not secret; written by scripts/stripe/setup-products.mjs)
STRIPE_ACCOUNT_ID=                  # local only, with the Stripe CLI OAuth token instead of an sk_test key (docs/billing/WEBHOOK-TEST.md)
BILLING_DB=                         # "memory" = local webhook tests without any database (refused on Netlify production)
